  <ItemGroup>
    <ProjectReference Include="..\..\src\Claustrum\Claustrum.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\fixtures\gh\**\*" LinkBase="fixtures\gh" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\opencode\quota-402.jsonl" LinkBase="fixtures\opencode" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
